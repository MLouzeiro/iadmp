generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  passwordHash    String
  telefone        String?
  role            Role                @default(MEMBER)
  perfilId        String?
  perfil          Perfil?             @relation(fields: [perfilId], references: [id])
  ativo           Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  avaliacoes      Avaliacao[]
  membro          Membro?
  organizacoes    UsuarioOrganizacao[]
  permissoes      UsuarioPermissao[]
  auditLogs       AuditLog[]
  pregacoes       Pregacao[]
  inscricoes      Inscricao[]
  pagamentos      Pagamento[]
  aprovacoesSolicitadas Aprovacao[]   @relation("Solicitante")
  aprovacoesDecididas   Aprovacao[]   @relation("Aprovador")
}

enum Role {
  SUPER_ADMIN
  ADMIN_IGREJA
  LIDER
  COORDENADOR
  MUSICO
  MEMBER
  ADMIN
  PASTOR
  SECRETARIA
  FINANCEIRO
  LIDER_MINISTERIO
  EDITOR_SITE
}

model Organizacao {
  id              String                @id @default(cuid())
  nome            String
  descricao       String?
  ativo           Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  usuarios        UsuarioOrganizacao[]
  congregacoes    Congregacao[]
  configuracoes   ConfiguracoesIgreja[]
  liturgias       Liturgia[]
  musicas         LiturgiaMusica[]
  modelos         LiturgiaModelo[]
  canaisOficiais  CanalOficial[]
  pregacoes       Pregacao[]
  versiculos      VersiculoDiario[]
  membros         Membro[]
  liderancas      Lideranca[]
  ministerios     Ministerio[]
  departamentos   Departamento[]
  eventos         Evento[]
  campanhas       Campanha[]
  financeiro      EventoFinanceiro[]
  categorias      CategoriaFinanceira[]
  avisos          Aviso[]
  galeriaAlbuns   GaleriaAlbum[]
  galeriaItens    GaleriaItem[]
  oportunidades   Oportunidade[]
  agendas         Agenda[]
  inscricoes      Inscricao[]
  pagamentos      Pagamento[]
  aprovacoes      Aprovacao[]
  auditLogs       AuditLog[]
  contatos        ContatoMensagem[]
}

model UsuarioOrganizacao {
  id              String        @id @default(cuid())
  userId          String
  organizacaoId   String
  perfilId        String?
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizacao     Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  perfil          Perfil?       @relation(fields: [perfilId], references: [id])

  @@unique([userId, organizacaoId])
  @@index([organizacaoId])
  @@index([perfilId])
}

model Congregacao {
  id              String        @id @default(cuid())
  organizacaoId   String
  nome            String
  descricao       String?
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizacao     Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  membros         Membro[]
  liturgias       Liturgia[]
  liderancas      Lideranca[]
  eventos         Evento[]
  campanhas       Campanha[]
  financeiro      EventoFinanceiro[]
  avisos          Aviso[]
  galeriaAlbuns   GaleriaAlbum[]
  galeriaItens    GaleriaItem[]
  oportunidades   Oportunidade[]
  agendas         Agenda[]
  inscricoes      Inscricao[]
  pagamentos      Pagamento[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

model Perfil {
  id              String              @id @default(cuid())
  nome            String              @unique
  descricao       String?
  isSystem        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  usuarios        User[]
  vinculos        UsuarioOrganizacao[]
  permissoes      PerfilPermissao[]
}

model Permissao {
  id              String              @id @default(cuid())
  modulo          String
  acao            String
  descricao       String?
  createdAt       DateTime            @default(now())
  perfilPermissoes PerfilPermissao[]
  usuarioPermissoes UsuarioPermissao[]

  @@unique([modulo, acao])
}

model PerfilPermissao {
  id              String    @id @default(cuid())
  perfilId        String
  permissaoId     String
  perfil          Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao       Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
}

model UsuarioPermissao {
  id              String    @id @default(cuid())
  userId          String
  permissaoId     String
  concedida       Boolean   @default(true)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissao       Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([userId, permissaoId])
}

model AuditLog {
  id              String          @id @default(cuid())
  userId          String
  organizacaoId   String?
  acao            String
  entidade        String
  entidadeId      String?
  antes           Json?
  depois          Json?
  detalhes        Json?
  ip              String?
  userAgent       String?
  resultado       String          @default("SUCESSO")
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizacao     Organizacao?    @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([userId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([createdAt])
}

model Membro {
  id             String        @id @default(cuid())
  organizacaoId  String
  congregacaoId  String?
  nome           String
  email          String?
  telefone       String?
  whatsapp       String?
  dataNascimento DateTime?
  endereco       String?
  foto           String?
  dataEntrada    DateTime      @default(now())
  status         StatusMembro  @default(ATIVO)
  observacoes    String?
  userId         String?        @unique
  user           User?           @relation(fields: [userId], references: [id])
  ministerioId   String?
  ministerio     Ministerio?   @relation(fields: [ministerioId], references: [id])
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao    Congregacao?  @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)
  lideranca      Lideranca[]
  inscricoes     Inscricao[]

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([organizacaoId, status])
}

enum StatusMembro {
  ATIVO
  INATIVO
  TRANSFERIDO
  FALECIDO
}

model Ministerio {
  id             String        @id @default(cuid())
  organizacaoId  String
  congregacaoId  String?
  nome           String
  descricao      String?
  responsavel    String?
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  membros        Membro[]
  lideranca      Lideranca[]

  @@index([organizacaoId])
}

model Departamento {
  id             String        @id @default(cuid())
  organizacaoId  String
  nome           String
  descricao      String?
  responsavel    String?
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  membros        Membro[]

  @@index([organizacaoId])
}

model Lideranca {
  id            String    @id @default(cuid())
  organizacaoId String
  congregacaoId String?
  nome          String
  cargo         String
  foto          String?
  biografia     String?
  ordemExibicao Int       @default(0)
  publico       Boolean   @default(true)
  ativo         Boolean   @default(true)
  dataInicio    DateTime?
  dataFim       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  membroId      String?
  membro        Membro?   @relation(fields: [membroId], references: [id])
  ministerioId  String?
  ministerio    Ministerio? @relation(fields: [ministerioId], references: [id])
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao   Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([congregacaoId])
}

model Evento {
  id                String         @id @default(cuid())
  organizacaoId     String
  congregacaoId     String?
  nome              String
  categoriaId       String?
  dataInicio        DateTime
  dataEvento        DateTime
  dataFim           DateTime?
  tema              String?
  preletores        String[]
  diasDuracao       Int?
  status            StatusEvento   @default(PLANEJADO)
  observacoes       String?
  local             String?
  responsavelGeral  String?
  publicarNoSite    Boolean        @default(false)
  orcamentoPrevisto Decimal?       @db.Decimal(10, 2)
  aceitaInscricoes  Boolean        @default(false)
  limiteInscricoes  Int?
  taxaInscricao     Decimal?       @db.Decimal(10, 2)
  chavePix          String?
  tipoChavePix      String?
  nomeRecebedor     String?
  cidadeRecebedor   String?
  totalDespesas     Decimal        @default(0) @db.Decimal(10, 2)
  totalReceitas     Decimal        @default(0) @db.Decimal(10, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organizacao       Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao       Congregacao?   @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)
  categoria         CategoriaEvento? @relation(fields: [categoriaId], references: [id])
  campanha          Campanha?
  avaliacao         Avaliacao?
  participantes     EventoParticipante[]
  financeiro        EventoFinanceiro[]
  liturgias         Liturgia[]
  galeriaItems      GaleriaItem[]
  agenda            Agenda[]
  tarefas           TarefaEvento[]
  inscricoes        Inscricao[]

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([organizacaoId, status])
  @@index([organizacaoId, dataEvento])
}

model CategoriaEvento {
  id        String    @id @default(cuid())
  nome      String
  descricao String?
  cor       String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  eventos   Evento[]
}

model EventoParticipante {
  id             String    @id @default(cuid())
  nome           String
  email          String?
  telefone       String?
  funcaoParticipante String @default("PARTICIPANTE")
  observacoes    String?
  createdAt      DateTime  @default(now())
  eventoId       String
  evento         Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model TarefaEvento {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  responsavel String?
  prazo       DateTime?
  concluida   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eventoId    String
  evento      Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

enum StatusEvento {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model Campanha {
  id              String    @id @default(cuid())
  organizacaoId   String
  congregacaoId   String?
  eventoId        String    @unique
  meta            Decimal   @db.Decimal(10, 2)
  valorArrecadado Decimal   @default(0) @db.Decimal(10, 2)
  dataInicio      DateTime
  dataFim         DateTime
  descricao       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  evento          Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao     Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
}

model CategoriaFinanceira {
  id            String    @id @default(cuid())
  organizacaoId String
  nome          String
  genero        String
  descricao     String?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  movimentacoes EventoFinanceiro[]

  @@index([organizacaoId])
  @@unique([organizacaoId, nome])
}

enum CategoriaLancamento {
  DIZIMO
  OFERTA
  DOACAO
  INSCRICAO
  DESPESA
  OUTRO
}

model EventoFinanceiro {
  id                    String    @id @default(cuid())
  organizacaoId         String
  congregacaoId         String?
  descricao             String
  valor                 Decimal   @db.Decimal(10, 2)
  quando                DateTime  @default(now())
  generoMovimentacao    String
  categoria             CategoriaLancamento @default(OUTRO)
  fornecedor            String?
  comprovante           String?
  responsavel           String?
  observacoes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  eventoId              String?
  evento                Evento?   @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  categoriaFinanceiraId String?
  categoriaFinanceira   CategoriaFinanceira? @relation(fields: [categoriaFinanceiraId], references: [id])
  organizacao           Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao           Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)
  pagamentos            Pagamento[]

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([eventoId])
  @@index([organizacaoId, categoria])
  @@index([organizacaoId, quando])
}

model Avaliacao {
  id                    String    @id @default(cuid())
  eventoId              String    @unique
  notaEquipe            Int
  observacoesEquipe     String?
  presencaEstimada      Int?
  planejamentoDiasAntes Int?
  metaAtingidaPercent   Decimal?  @db.Decimal(5, 2)
  sugestoesAutomaticas  String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  evento                Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id])
}

model Liturgia {
  id                  String              @id @default(cuid())
  organizacaoId       String
  congregacaoId       String?
  data                DateTime
  horarioInicio       String
  horarioFimPrevisto  String?
  tipoCulto           String              @default("Celebracao")
  tema                String?
  dirigente           String?
  dirigenteUserId     String?
  pregador            String?
  pregadorUserId      String?
  responsavel         String?
  responsavelUserId   String?
  observacoes         String?
  status              StatusLiturgia      @default(RASCUNHO)
  modeloId            String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  eventoId            String?
  evento              Evento?             @relation(fields: [eventoId], references: [id])
  itens               LiturgiaItem[]
  pregacao            Pregacao?
  organizacao         Organizacao         @relation(fields: [organizacaoId], references: [id])
  congregacao         Congregacao?        @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([organizacaoId, data])
}

enum StatusLiturgia {
  RASCUNHO
  EM_PREPARACAO
  PRONTA
  EM_ANDAMENTO
  REALIZADA
  CANCELADA
}

model LiturgiaItem {
  id                  String              @id @default(cuid())
  ordem               Int
  tipo                String
  titulo              String
  horarioPrevisto     String?
  duracaoPrevista     Int?
  responsavel         String?
  responsavelUserId   String?
  descricao           String?
  observacoes         String?
  musicaId            String?
  referenciaBiblica   String?
  livroBiblico        String?
  capituloBiblico     String?
  versiculoInicio     String?
  versiculoFim        String?
  textoBiblico        String?
  temaPregacao        String?
  prioridade          String              @default("NORMAL")
  status              StatusMomento       @default(PENDENTE)
  iniciadoEm          DateTime?
  finalizadoEm        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  liturgiaId          String
  liturgia            Liturgia            @relation(fields: [liturgiaId], references: [id], onDelete: Cascade)
  musica              LiturgiaMusica?     @relation(fields: [musicaId], references: [id])
}

enum StatusMomento {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model LiturgiaMusica {
  id              String    @id @default(cuid())
  organizacaoId   String
  titulo          String
  compositor      String?
  artista         String?
  tom             String?
  categoria       String    @default("Adoracao")
  letra           String?
  link            String?
  observacoes     String?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id])
  momentos        LiturgiaItem[]
}

model LiturgiaModelo {
  id              String                @id @default(cuid())
  organizacaoId   String
  nome            String
  descricao       String?
  tipoCulto       String?
  ativo           Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdById     String?
  organizacao     Organizacao           @relation(fields: [organizacaoId], references: [id])
  momentos        LiturgiaModeloMomento[]
}

model LiturgiaModeloMomento {
  id                  String    @id @default(cuid())
  ordem               Int
  tipo                String
  titulo              String
  duracaoPrevista     Int?
  descricao           String?
  observacoes         String?
  musicaId            String?
  referenciaBiblica   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  modeloId            String
  modelo              LiturgiaModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
}

model Agenda {
  id            String    @id @default(cuid())
  organizacaoId String
  congregacaoId String?
  titulo        String
  descricao     String?
  comeco        DateTime
  termino       DateTime?
  horario       String?
  local         String?
  recorrente    Boolean   @default(false)
  recorrencia   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  eventoId      String?
  evento        Evento?   @relation(fields: [eventoId], references: [id])
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao   Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([congregacaoId])
}

model Aviso {
  id             String    @id @default(cuid())
  organizacaoId  String
  congregacaoId  String?
  titulo         String
  descricao      String
  imagem         String?
  categoria      String?
  comecaEm       DateTime  @default(now())
  terminaEm      DateTime?
  urgencia       String    @default("NORMAL")
  situacaoAviso  String    @default("ATIVO")
  publicoAlvo    String?
  publicarSite   Boolean   @default(false)
  mostrarPainel  Boolean   @default(true)
  destaque       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao    Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([organizacaoId, situacaoAviso])
}

model GaleriaAlbum {
  id            String    @id @default(cuid())
  organizacaoId String
  congregacaoId String?
  nome          String
  descricao     String?
  capa          String?
  momentAlbum   DateTime?
  publico       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao   Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)
  itens         GaleriaItem[]

  @@index([organizacaoId])
}

model GaleriaItem {
  id            String    @id @default(cuid())
  organizacaoId String
  congregacaoId String?
  titulo        String?
  descricao     String?
  url           String
  classArquivo  String    @default("FOTO")
  ordem         Int       @default(0)
  momentoItem   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  albumId       String?
  album         GaleriaAlbum? @relation(fields: [albumId], references: [id])
  eventoId      String?
  evento        Evento?   @relation(fields: [eventoId], references: [id])
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao   Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([albumId])
  @@index([eventoId])
}

model Oportunidade {
  id                 String    @id @default(cuid())
  organizacaoId      String
  congregacaoId      String?
  titulo             String
  descricao          String
  generoOportunidade String
  responsavel        String?
  prazo              DateTime?
  vagas              Int?
  abrirOportunidade  String    @default("ATIVA")
  observacoes        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao        Congregacao? @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
}

model ConfiguracoesIgreja {
  id               String   @id @default(cuid())
  organizacaoId    String   @unique
  nomeIgreja       String   @default("Igreja Assembleia de Deus Ministerio da Promessa")
  logoUrl          String?
  logoDarkUrl      String?
  faviconUrl       String?
  corPrincipal      String   @default("#C8960C")
  corSecundaria    String   @default("#C41E1E")
  corDestaque      String   @default("#D4A017")
  corFundo         String   @default("#0A1628")
  corFundoClaro    String   @default("#F5E6C8")
  corSuperficie    String   @default("#0D1F35")
  corTexto         String   @default("#F0ECE2")
  corTextoSecundario String @default("#C8C2B6")
  corBorda         String   @default("rgba(201, 168, 76, 0.12)")
  tema             String   @default("dark")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organizacao      Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
}

model CanalOficial {
  id              String    @id @default(cuid())
  organizacaoId   String
  tipo            String
  nome            String
  url             String
  descricao       String?
  ativo           Boolean   @default(true)
  ordem           Int       @default(0)
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
  @@index([organizacaoId, tipo])
}

enum StatusPregacao {
  RASCUNHO
  PUBLICADA
  ARQUIVADA
}

model Pregacao {
  id                  String        @id @default(cuid())
  organizacaoId       String
  liturgiaId          String?     @unique
  titulo              String
  slug                String        @unique
  descricao           String?
  tema                String?
  tipo                String        @default("Pregacao")
  pregadorId          String?
  pregadorNome        String?
  data                DateTime
  referenciaLivro     String?
  referenciaCapitulo  Int?
  referenciaVersIni   Int?
  referenciaVersFim   Int?
  videoUrl            String?
  capaUrl             String?
  observacoes         String?
  status              StatusPregacao @default(RASCUNHO)
  destaque            Boolean       @default(false)
  createdById         String?
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  liturgia            Liturgia?     @relation(fields: [liturgiaId], references: [id], onDelete: SetNull)
  pregador            User?         @relation(fields: [pregadorId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([organizacaoId, status])
  @@index([organizacaoId, data])
  @@index([pregadorId])
  @@index([liturgiaId])
}

model VersiculoDiario {
  id              String    @id @default(cuid())
  organizacaoId   String
  referencia      String
  versiculo       String
  reflexao        String
  ativo           Boolean   @default(true)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  historico       VersiculoHistorico[]

  @@index([organizacaoId])
  @@index([organizacaoId, ativo])
}

model VersiculoHistorico {
  id              String    @id @default(cuid())
  versiculoId     String
  slot            Int
  exibidoEm       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  versiculo       VersiculoDiario @relation(fields: [versiculoId], references: [id], onDelete: Cascade)

  @@index([versiculoId])
  @@index([slot])
  @@unique([versiculoId, slot])
}

enum StatusInscricao {
  PENDENTE
  CONFIRMADA
  CANCELADA
  REALIZADA
}

model Inscricao {
  id              String           @id @default(cuid())
  organizacaoId   String
  congregacaoId   String?
  eventoId        String
  membroId        String?
  nome            String
  email           String?
  telefone        String?
  status          StatusInscricao  @default(PENDENTE)
  valorPrevisto   Decimal?         @db.Decimal(10, 2)
  valorPago       Decimal          @default(0) @db.Decimal(10, 2)
  checkIn         Boolean          @default(false)
  dataCheckIn     DateTime?
  observacoes     String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizacao     Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao     Congregacao?     @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)
  evento          Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  membro          Membro?          @relation(fields: [membroId], references: [id], onDelete: SetNull)
  criador         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  pagamentos      Pagamento[]

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([eventoId])
  @@index([membroId])
  @@index([organizacaoId, status])
}

enum StatusPagamento {
  PENDENTE
  PARCIAL
  PAGO
  ESTORNADO
  ERRO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
  TRANSFERENCIA
  BOLETO
  OUTRO
}

model Pagamento {
  id                  String           @id @default(cuid())
  organizacaoId       String
  congregacaoId       String?
  inscricaoId         String?
  eventoFinanceiroId  String?
  descricao           String
  valor               Decimal          @db.Decimal(10, 2)
  forma               FormaPagamento   @default(DINHEIRO)
  status              StatusPagamento  @default(PENDENTE)
  txidPix             String?
  comprovante         String?
  estornadoDeId       String?
  dataPagamento       DateTime?
  observacoes         String?
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  organizacao         Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  congregacao         Congregacao?     @relation(fields: [congregacaoId], references: [id], onDelete: SetNull)
  inscricao           Inscricao?       @relation(fields: [inscricaoId], references: [id], onDelete: SetNull)
  eventoFinanceiro    EventoFinanceiro? @relation(fields: [eventoFinanceiroId], references: [id], onDelete: SetNull)
  criador             User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  estornadoDe         Pagamento?       @relation("Estorno", fields: [estornadoDeId], references: [id], onDelete: SetNull)
  estornos            Pagamento[]      @relation("Estorno")

  @@index([organizacaoId])
  @@index([congregacaoId])
  @@index([inscricaoId])
  @@index([eventoFinanceiroId])
  @@index([organizacaoId, status])
  @@index([txidPix])
}

enum StatusAprovacao {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
}

model Aprovacao {
  id              String           @id @default(cuid())
  organizacaoId   String
  entidade        String
  entidadeId      String
  tipo            String
  solicitanteId   String
  aprovadorId     String?
  status          StatusAprovacao  @default(PENDENTE)
  justificativa   String?
  observacoes     String?
  decididoEm      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizacao     Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  solicitante     User             @relation("Solicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  aprovador       User?            @relation("Aprovador", fields: [aprovadorId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([entidade, entidadeId])
  @@index([solicitanteId])
  @@index([aprovadorId])
  @@index([organizacaoId, status])
}

model ContatoMensagem {
  id             String       @id @default(cuid())
  organizacaoId  String?
  nome           String
  email          String
  telefone       String?
  assunto        String?
  mensagem       String
  lida           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organizacao    Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([createdAt])
}
