# === BANCO DE DADOS (obrigatório) ===
DATABASE_URL=

# === NEXTAUTH (obrigatório) ===
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# === SUPABASE STORAGE (opcional — imagens/banners/galeria) ===
# URL do projeto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (anon) — SEGURA para frontend; NUNCA usar a service_role aqui
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bucket público usado para imagens do site (criar no painel Supabase → Storage)
NEXT_PUBLIC_SUPABASE_BUCKET=imagens
